load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//rules_fortran:defs.bzl", "fortran_binary", "fortran_library")

fortran_library(
    name = "base",
    srcs = ["base.f90"],
)

fortran_library(
    name = "mid",
    srcs = ["mid.f90"],
    deps = [":base"],
)

# `mid` calls into `base`, so a link that scans `base` before `mid` leaves the
# symbols from `base` undefined.
fortran_binary(
    name = "fortran_static_deps",
    srcs = ["main.f90"],
    deps = [":mid"],
)

sh_test(
    name = "fortran_static_deps_test",
    srcs = ["fortran_static_deps_test.sh"],
    data = [":fortran_static_deps"],
    env = {
        "BINARY": "$(rootpath :fortran_static_deps)",
    },
)
